# Copy to .env, fill in real values. Never commit .env.

# Anthropic Claude API — required for run-agent.ts
ANTHROPIC_API_KEY=

# AI-detection — pick ONE
ZEROGPT_API_KEY=
ORIGINALITY_API_KEY=

# Analytics
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=stonemegan.dev
CF_ANALYTICS_TOKEN=
GSC_SERVICE_ACCOUNT=          # base64 of Google service account JSON

# Deployment
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Site config (also in .claude/settings.json env)
SITE_URL=https://stonemegan.dev
TARGET_GEO=uk,au,nz

# Newsletter — Beehiiv form ID (UUID).
# Get from Beehiiv: Subscribers → Subscribe forms → your form → Embed
# code. The UUID is the value of `data-beehiiv-form` on the script tag.
# Example: 856a2994-70b2-4e50-808b-51fdc0720257
# When unset, SubscribeForm shows an RSS fallback (still ships safely).
# PUBLIC_ prefix is required so Astro exposes it to the static build.
PUBLIC_BEEHIIV_FORM_ID=
