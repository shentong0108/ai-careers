# Copy to .env, fill in real values. Never commit .env.

# Anthropic Claude API — required for run-agent.ts
ANTHROPIC_API_KEY=

# AI-detection — pick ONE
ZEROGPT_API_KEY=
ORIGINALITY_API_KEY=

# Analytics
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=stonemegan.dev
CF_ANALYTICS_TOKEN=
GSC_SERVICE_ACCOUNT=          # base64 of Google service account JSON

# Deployment
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Site config (also in .claude/settings.json env)
SITE_URL=https://stonemegan.dev
TARGET_GEO=uk,au,nz
