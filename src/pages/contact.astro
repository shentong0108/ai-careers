---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — stonemegan.dev"
  description="How to reach Stone and Megan about posts on stonemegan.dev."
>
  <h1>Contact</h1>

  <p>
    Easiest way: email
    <a href="mailto:hello@stonemegan.dev">hello@stonemegan.dev</a>.
  </p>

  <p>We read every message. Reply time is usually within a week (we both have day jobs).</p>

  <h2>What to email about</h2>
  <ul>
    <li>Corrections to a post — please include the URL and the specific claim.</li>
    <li>Suggestions for topics you'd like covered.</li>
    <li>Affiliate / sponsorship enquiries — we accept very few; quality fit only.</li>
    <li>Press / interview requests.</li>
  </ul>

  <h2>What not to email about</h2>
  <ul>
    <li>Medical advice — we cannot give clinical advice; see your supervisor or GP.</li>
    <li>Childcare crises — please call your local child-protection line.</li>
    <li>Guest-post pitches from agencies — auto-deleted.</li>
  </ul>

  <h2>Found a security issue?</h2>
  <p>
    Email <a href="mailto:security@stonemegan.dev">security@stonemegan.dev</a>.
    We will reply within 72 hours.
  </p>
</BaseLayout>
