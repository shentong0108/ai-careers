---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { CATEGORIES, type CategoryKey } from '@/lib/categories';

export const getStaticPaths = (() =>
  Object.keys(CATEGORIES).map((category) => ({
    params: { category },
  }))) satisfies GetStaticPaths;

const { category } = Astro.params;
const meta = CATEGORIES[category as CategoryKey];
if (!meta) throw new Error(`Unknown category: ${category}`);

const posts = (await getCollection(
  'posts',
  ({ data }: CollectionEntry<'posts'>) => !data.draft && data.category === category
))
  .sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) =>
    b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
  );
---

<BaseLayout
  title={`${meta.title} — stonemegan.dev`}
  description={meta.description}
>
  <section class="hero" style="padding-top: 1rem;">
    <div class="niche-dots" aria-hidden="true">
      <span class="dot" data-niche={category}>{meta.title.charAt(0)}</span>
    </div>
    <h1 style="max-width: 16ch;">{meta.title}</h1>
    <p class="sub">{meta.intro}</p>
  </section>

  <h2 class="section-title">All posts</h2>

  {posts.length === 0 ? (
    <p style="color: var(--c-muted); text-align: center; padding: 2rem 0;">
      No posts yet in this category. First one coming soon.
    </p>
  ) : (
    <div>
      {posts.map((p: CollectionEntry<'posts'>) => (
        <a class="post-card" href={`/blog/${p.data.slug}`}>
          <span class="niche-tag" data-niche={p.data.category}>{meta.title}</span>
          <h3>{p.data.title}</h3>
          <p class="description">{p.data.description}</p>
          <p class="meta">
            {p.data.publishedAt.toISOString().slice(0, 10)}
            <span style="margin: 0 0.4rem; opacity: 0.5">·</span>
            by {p.data.author === 'stone' ? 'Stone' : 'Megan'}
          </p>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
