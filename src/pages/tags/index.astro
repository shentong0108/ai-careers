---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

function slugifyTag(tag: string): string {
  return tag
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

const posts = await getCollection('posts', ({ data }: CollectionEntry<'posts'>) => !data.draft);
const tagCount = new Map<string, { label: string; count: number }>();
for (const post of posts) {
  for (const raw of post.data.tags ?? []) {
    const slug = slugifyTag(raw);
    if (!slug) continue;
    const existing = tagCount.get(slug);
    if (existing) existing.count += 1;
    else tagCount.set(slug, { label: raw, count: 1 });
  }
}
const tags = Array.from(tagCount.entries())
  .map(([slug, { label, count }]) => ({ slug, label, count }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
---

<BaseLayout
  title="All tags — stonemegan"
  description="Browse every topic covered on stonemegan.dev — nurse + AI, ECT + AI, dev diary. Stories from a Sydney RN, an ECT, and an indie dev."
  canonical="https://stonemegan.dev/tags/"
>
  <div class="container" style="padding-top: 3rem; padding-bottom: 2rem;">
    <p class="eyebrow" style="text-transform: uppercase; letter-spacing: 2px; color: var(--c-muted); font-size: 0.85rem; margin: 0 0 0.5rem;">
      Topics
    </p>
    <h1 style="margin: 0 0 1.5rem;">All tags</h1>
    <p style="color: var(--c-text-soft); margin: 0 0 2rem;">
      Every topic surfaced across <strong>{posts.length}</strong> published articles.
    </p>

    <ul class="tag-cloud">
      {tags.map((t) => (
        <li>
          <a href={`/tags/${t.slug}/`} class="tag-chip">
            {t.label} <span class="tag-count">({t.count})</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .tag-cloud {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.95rem;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--c-teal);
    background: var(--c-bg-soft);
    border: 1px solid var(--c-border);
    border-radius: 999px;
    text-decoration: none;
    background-image: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .tag-chip:hover {
    background: var(--c-teal);
    color: #ffffff;
    border-color: var(--c-teal);
    text-decoration: none;
  }
  .tag-count {
    font-weight: 500;
    opacity: 0.75;
    font-size: 0.82rem;
  }
</style>
