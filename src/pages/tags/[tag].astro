---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';

const NICHE_LABEL: Record<string, string> = {
  'nurse-ai': 'Nurse + AI',
  'ece-ai': 'ECT + AI',
  'dev-diary': 'Dev Diary',
};

export const getStaticPaths = (async () => {
  // Astro hoists getStaticPaths into an isolated module — closures from
  // the surrounding frontmatter aren't visible here. Define the slugify
  // helper inline.
  const slugifyTag = (tag: string): string =>
    tag.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

  const posts = await getCollection('posts', ({ data }: CollectionEntry<'posts'>) => !data.draft);
  const tagSet = new Map<string, string>();
  for (const post of posts) {
    for (const raw of post.data.tags ?? []) {
      const slug = slugifyTag(raw);
      if (slug && !tagSet.has(slug)) {
        tagSet.set(slug, raw);
      }
    }
  }
  return Array.from(tagSet.entries()).map(([slug, label]) => ({
    params: { tag: slug },
    props: { label },
  }));
}) satisfies GetStaticPaths;

function slugifyTag(tag: string): string {
  return tag
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

interface Props {
  label: string;
}

const { tag } = Astro.params;
const { label } = Astro.props as Props;

const allPosts = await getCollection('posts', ({ data }: CollectionEntry<'posts'>) => !data.draft);
const posts = allPosts
  .filter((p: CollectionEntry<'posts'>) =>
    (p.data.tags ?? []).some((t: string) => slugifyTag(t) === tag)
  )
  .sort(
    (a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) =>
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
  );

const canonicalLabel = label;
const pageTitle = `Articles tagged "${canonicalLabel}" — stonemegan`;
const pageDescription = `Every article on stonemegan.dev tagged ${canonicalLabel}. Stories from a Sydney RN, an ECT, and an indie dev working with AI.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`https://stonemegan.dev/tags/${tag}/`}
>
  <div class="container" style="padding-top: 3rem; padding-bottom: 2rem;">
    <p class="eyebrow" style="text-transform: uppercase; letter-spacing: 2px; color: var(--c-muted); font-size: 0.85rem; margin: 0 0 0.5rem;">
      Tag
    </p>
    <h1 style="margin: 0 0 2rem;">{canonicalLabel}</h1>

    {posts.length === 0 ? (
      <p>No articles yet for this tag. <a href="/">Back to homepage</a>.</p>
    ) : (
      <div class="article-list">
        {posts.map((p: CollectionEntry<'posts'>) => (
          <article class="article-row">
            <p class="meta-line">
              <time datetime={p.data.publishedAt.toISOString()}>
                {p.data.publishedAt.toISOString().slice(0, 10)}
              </time>
              <span class="dot">·</span>
              <a href={`/${p.data.category}/`} class="niche-link" data-niche={p.data.category}>
                {NICHE_LABEL[p.data.category]}
              </a>
            </p>
            <h2 style="margin: 0 0 0.4rem;">
              <a href={`/blog/${p.data.slug}/`} style="color: inherit; text-decoration: none;">
                {p.data.title}
              </a>
            </h2>
            <p style="color: var(--c-text-soft); margin: 0;">{p.data.description}</p>
          </article>
        ))}
      </div>
    )}

    <p style="margin-top: 2.5rem;">
      <a href="/tags/">← All tags</a>
    </p>
  </div>
</BaseLayout>
