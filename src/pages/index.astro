---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const posts = (await getCollection('posts', ({ data }: CollectionEntry<'posts'>) => !data.draft))
  .sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) =>
    b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
  )
  .slice(0, 10);

const NICHE_LABEL: Record<string, string> = {
  'nurse-ai': 'Nurse + AI',
  'ece-ai': 'ECE + AI',
  'dev-diary': 'Dev Diary',
};
---

<BaseLayout
  title="stonemegan.dev — nurse + ECE + AI, no hype"
  description="Real stories from a Sydney-based nurse and an early-childhood teacher using AI in their jobs. Plus an indie dev diary. No buzzwords. Failures included."
>
  <section class="hero">
    <div class="niche-dots" aria-hidden="true">
      <span class="dot" data-niche="nurse-ai">N</span>
      <span class="dot" data-niche="ece-ai">E</span>
      <span class="dot" data-niche="dev-diary">D</span>
    </div>
    <h1>What AI actually does in our jobs.</h1>
    <p class="divider">· · · · · · ·</p>
    <p class="sub">
      A Sydney-based RN and an early-childhood teacher write about the AI tools we actually use
      day to day — including the ones we dropped.
    </p>
    <a class="cta" href="#latest">Browse latest →</a>
  </section>

  <h2 class="section-title" id="latest">Latest</h2>

  {posts.length === 0 ? (
    <p style="color: var(--c-muted); text-align: center; padding: 2rem 0;">
      First articles coming soon.
    </p>
  ) : (
    <div>
      {posts.map((p: CollectionEntry<'posts'>) => (
        <a class="post-card" href={`/blog/${p.data.slug}`}>
          <span class="niche-tag" data-niche={p.data.category}>{NICHE_LABEL[p.data.category]}</span>
          <h3>{p.data.title}</h3>
          <p class="description">{p.data.description}</p>
          <p class="meta">
            {p.data.publishedAt.toISOString().slice(0, 10)}
            <span style="margin: 0 0.4rem; opacity: 0.5">·</span>
            by {p.data.author === 'stone' ? 'Stone' : 'Megan'}
          </p>
        </a>
      ))}
    </div>
  )}

  <h2 class="section-title">By topic</h2>
  <div>
    <a class="post-card" href="/nurse-ai">
      <span class="niche-tag" data-niche="nurse-ai">Nurse + AI</span>
      <h3>AI tools for nursing practice</h3>
      <p class="description">Written by an AHPRA-registered RN. Real shifts. What helps, what wastes time.</p>
    </a>
    <a class="post-card" href="/ece-ai">
      <span class="niche-tag" data-niche="ece-ai">ECE + AI</span>
      <h3>AI for early-childhood educators</h3>
      <p class="description">Written by a working ECT in Sydney. Lesson plans, parent comms, observations.</p>
    </a>
    <a class="post-card" href="/dev-diary">
      <span class="niche-tag" data-niche="dev-diary">Dev Diary</span>
      <h3>Indie dev diary with Claude Code</h3>
      <p class="description">Building public, including the projects I killed and why.</p>
    </a>
  </div>
</BaseLayout>
