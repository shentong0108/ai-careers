---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const posts = (await getCollection('posts', ({ data }: CollectionEntry<'posts'>) => !data.draft))
  .sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) =>
    b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
  );

const NICHE_LABEL: Record<string, string> = {
  'nurse-ai': 'Nurse + AI',
  'ece-ai': 'ECT + AI',
  'dev-diary': 'Dev Diary',
};
---

<BaseLayout
  title="stonemegan — nurse + ECT + AI, no hype"
  description="Real stories from a Sydney-based RN and an early-childhood teacher using AI in their jobs. Plus an indie dev diary. No buzzwords. Failures included."
>
  <section class="hero-banner" style="background-image: url('/images/hero-default.jpg'); min-height: 540px;">
    <div class="hero-card-container">
      <div class="hero-card" style="max-width: 620px;">
        <div class="author-duo">
          <img src="/authors/stone.svg" alt="Stone" />
          <img src="/authors/megan.svg" alt="Megan" />
          <span class="label">
            <strong>Stone &amp; Megan</strong>
            Sydney · RN + ECT
          </span>
        </div>
        <h1 class="display-xl">
          What AI actually <em>does</em> in our jobs.
        </h1>
        <p style="font-size: 1.12rem; color: var(--c-text-soft); margin: 0;">
          Two real professionals — a nurse and an early-childhood teacher —
          writing about the AI tools we use on shift. Including the ones we
          dropped. Including the failures.
        </p>
      </div>
    </div>
  </section>

  <div class="author-intro">
    <p class="greeting">Hey, we're Stone &amp; Megan</p>
    <p>
      <strong>Stone</strong> is an AHPRA-registered RN running solo in a Sydney
      primary-care clinic. <strong>Megan</strong> is an ACECQA-registered ECT in
      a Sydney pre-school room. We started this blog because every AI-in-our-job
      article we found was written by someone whose job is writing AI articles.
    </p>
    <p>
      Real shifts. Real rooms. Real failures. Posts every couple of days —
      sometimes the system, sometimes the story behind a single near-miss.
    </p>
  </div>

  <div class="container" id="latest">
    {posts.length === 0 ? (
      <p style="color: var(--c-muted); text-align: center; padding: 3rem 0;">
        First articles coming soon.
      </p>
    ) : (
      <ul class="article-list">
        {posts.map((p: CollectionEntry<'posts'>) => (
          <li class="article-row">
            <p class="meta-line">
              <time datetime={p.data.publishedAt.toISOString()}>
                {p.data.publishedAt.toISOString().slice(0, 10)}
              </time>
              <span class="dot">·</span>
              <span class="niche-mini" data-niche={p.data.category}>{NICHE_LABEL[p.data.category]}</span>
              <span class="dot">·</span>
              <span>{p.data.author === 'stone' ? 'Stone' : 'Megan'}</span>
            </p>
            <h2 class="row-title">
              <a href={`/blog/${p.data.slug}`}>{p.data.title}</a>
            </h2>
            <p class="row-desc">{p.data.description}</p>
            <a href={`/blog/${p.data.slug}`}><span class="read-more">Read</span></a>
          </li>
        ))}
      </ul>
    )}
  </div>

  <div class="container" id="newsletter">
    <div class="signup-block">
      <p class="eyebrow">Get a real post once a week</p>
      <h3>No filler. No hype. Just what we tried.</h3>
      <p>Drop your email and we'll send the new post the morning it goes up. Unsubscribe anytime.</p>
      <form id="signup" action="#" method="post" onsubmit="event.preventDefault(); alert('Newsletter sign-up coming soon — for now bookmark the site or subscribe via RSS.'); return false;">
        <input type="email" placeholder="you@example.com" aria-label="Email address" required />
        <button type="submit">Notify me</button>
      </form>
      <p class="note">No subscriber list active yet — this form is a placeholder until we wire up an email provider.</p>
    </div>
  </div>

  <section class="cta-band">
    <h2>Failures included. On purpose.</h2>
    <p>
      Most AI blogs sell you a workflow that worked. Ours show you the
      iron-infusion record that nearly shipped without its batch number,
      the four prompts before the AI stopped sounding corporate, and the
      day-14 project we killed.
    </p>
    <a class="pill" href="/dev-diary">Read the dev diary →</a>
  </section>
</BaseLayout>
