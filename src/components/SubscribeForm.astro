---
/**
 * SubscribeForm — newsletter signup, Beehiiv-backed.
 *
 * Wiring:
 *   Set PUBLIC_BEEHIIV_PUB_URL in .env to your Beehiiv publication's
 *   form embed URL (looks like https://embeds.beehiiv.com/<uuid>).
 *   When unset, renders a graceful fallback pointing to RSS.
 *
 * The form posts directly to Beehiiv (iframe embed handles success
 * state, GDPR consent, double opt-in). No JS or API key on the
 * client side; we never touch the subscriber data.
 *
 * Variants:
 *   <SubscribeForm variant="inline" />   — footer-of-article CTA
 *   <SubscribeForm variant="block" />    — homepage hero block
 */

export interface Props {
  variant?: 'inline' | 'block';
  heading?: string;
  pitch?: string;
}

const { variant = 'block', heading, pitch } = Astro.props;
const embedUrl = import.meta.env.PUBLIC_BEEHIIV_PUB_URL || '';
const defaultHeading =
  variant === 'inline'
    ? 'Liked this? Get the next one in your inbox.'
    : 'No filler. No hype. Just what we tried.';
const defaultPitch =
  variant === 'inline'
    ? 'One post a week — nurse + AI, ECT + AI, dev diary. Unsubscribe anytime.'
    : "Drop your email and we'll send the new post the morning it goes up. Unsubscribe anytime.";
---

<div class={`subscribe-form subscribe-${variant}`}>
  {variant === 'block' && <p class="eyebrow">Get a real post once a week</p>}
  <h3>{heading ?? defaultHeading}</h3>
  <p class="pitch">{pitch ?? defaultPitch}</p>

  {embedUrl ? (
    <iframe
      src={embedUrl}
      data-test-id="beehiiv-embed"
      frameborder="0"
      scrolling="no"
      style="margin: 0; border-radius: 0; background-color: transparent;"
      title="Subscribe to stonemegan.dev"
    ></iframe>
  ) : (
    <p class="fallback">
      Newsletter wiring in progress. For now: subscribe via
      <a href="/rss.xml">RSS</a> or bookmark the
      <a href="/">homepage</a> — new posts ship most mornings.
    </p>
  )}
</div>

<style>
  .subscribe-form {
    background: var(--c-surface, #f7f5f0);
    border: 1px solid var(--c-border, #e0dcd2);
    border-radius: 6px;
    padding: 1.75rem 1.5rem;
    margin: 2.5rem 0;
  }
  .subscribe-inline {
    margin: 3rem 0 1.5rem;
  }
  .subscribe-form .eyebrow {
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--c-muted, #6b6258);
    margin: 0 0 0.5rem;
  }
  .subscribe-form h3 {
    margin: 0 0 0.5rem;
    font-size: 1.35rem;
    line-height: 1.3;
  }
  .subscribe-form .pitch {
    color: var(--c-muted, #6b6258);
    font-size: 0.95rem;
    margin: 0 0 1rem;
  }
  .subscribe-form iframe {
    width: 100%;
    min-height: 64px;
    display: block;
  }
  .subscribe-form .fallback {
    font-size: 0.9rem;
    color: var(--c-muted, #6b6258);
    margin: 0;
  }
  .subscribe-form .fallback a {
    color: var(--c-accent, #a04a3a);
    text-decoration: underline;
  }
</style>
