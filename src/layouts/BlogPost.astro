---
import BaseLayout from './BaseLayout.astro';
import AuthorByline from '@/components/AuthorByline.astro';
import Schema from '@/components/Schema.astro';
import SubscribeForm from '@/components/SubscribeForm.astro';
import authorsJson from '../../.claude/authors.json';
import { render, getCollection, type CollectionEntry } from 'astro:content';

interface AuthorRecord {
  name: string;
  jobTitle: string;
  credential: string;
  bio: string;
  url: string;
  sameAs: string[];
  image: string;
}
const authors = authorsJson as Record<string, AuthorRecord>;

const allPosts = await getCollection('posts', ({ data }: CollectionEntry<'posts'>) => !data.draft);

export interface Props {
  entry: CollectionEntry<'posts'>;
}

const NICHE_LABEL: Record<string, string> = {
  'nurse-ai': 'Nurse + AI',
  'ece-ai': 'ECT + AI',
  'dev-diary': 'Dev Diary',
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const fm = entry.data;
const author = authors[fm.author];
if (!author) throw new Error(`Unknown author: ${fm.author}`);

const breadcrumb = [
  { name: 'Home', url: new URL('/', Astro.site).toString() },
  { name: NICHE_LABEL[fm.category] ?? fm.category, url: new URL(`/${fm.category}`, Astro.site).toString() },
  { name: fm.title, url: fm.canonical },
];

// Read next: prefer same-niche posts, exclude current, take 2
const sameNiche = allPosts.filter(
  (p: CollectionEntry<'posts'>) => p.data.category === fm.category && p.data.slug !== fm.slug
);
const otherNiche = allPosts.filter(
  (p: CollectionEntry<'posts'>) => p.data.category !== fm.category && p.data.slug !== fm.slug
);
const readNext = [...sameNiche, ...otherNiche].slice(0, 2);
---

<BaseLayout
  title={fm.title}
  description={fm.description}
  canonical={fm.canonical}
  ogImage={fm.ogImage ?? fm.heroImage}
  type="article"
>
  <section
    class="hero-banner hero-banner--article"
    style={`background-image: url('${fm.heroImage}');`}
    role="img"
    aria-label={`Hero image for "${fm.title}"`}
  >
    {/* Hidden <img> so crawlers (Google Images, Bing) can index the
        hero, screen readers can announce alt, and the asset gets
        preloaded with priority. CSS bg-image stays for visual layout. */}
    <img
      src={fm.heroImage}
      alt={fm.title}
      loading="eager"
      fetchpriority="high"
      width="1200"
      height="630"
      style="position:absolute; width:1px; height:1px; opacity:0; pointer-events:none;"
    />
    <div class="hero-card-container">
      <div class="hero-card">
        <p class="eyebrow">
          <a href={`/${fm.category}`} style="color: inherit; text-decoration: none;">
            {NICHE_LABEL[fm.category]}
          </a>
        </p>
        <h1>{fm.title}</h1>
        <p>{fm.description}</p>
      </div>
    </div>
  </section>

  <div class="container" style="padding-top: 3rem; padding-bottom: 2rem;">
    <article class="post">
      <AuthorByline authorKey={fm.author} publishedAt={fm.publishedAt} />
      <Content />
      {fm.factChecked && (
        <p style="color: var(--c-muted); font-family: var(--font-sans); font-size: 0.85rem; border-top: 1px solid var(--c-border); padding-top: 1.25rem; margin-top: 3rem;">
          Fact-checked {fm.factCheckedAt?.toISOString().slice(0, 10)}.
          Last reviewed {fm.updatedAt.toISOString().slice(0, 10)}.
        </p>
      )}
    </article>

    <SubscribeForm variant="inline" />

    <div class="post-author-footer">
      <img src={author.image} alt={author.name} />
      <div class="body">
        <p>{author.name} · {author.jobTitle}</p>
        <p>{author.bio}</p>
        <p>More from {author.name} in <a href={`/${fm.category}`}>{NICHE_LABEL[fm.category]}</a>.</p>
      </div>
    </div>

    {readNext.length > 0 && (
      <div class="read-next">
        <p class="read-next-title">Read next</p>
        <div class="read-next-grid">
          {readNext.map((p: CollectionEntry<'posts'>) => (
            <a href={`/blog/${p.data.slug}`}>
              <p class="rn-niche" data-niche={p.data.category}>{NICHE_LABEL[p.data.category]}</p>
              <h3>{p.data.title}</h3>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <Schema
    type="Article"
    data={{
      headline: fm.title,
      description: fm.description,
      datePublished: fm.publishedAt.toISOString(),
      dateModified: fm.updatedAt.toISOString(),
      image: new URL(fm.heroImage, Astro.site).toString(),
      author: {
        '@type': 'Person',
        name: author.name,
        jobTitle: author.jobTitle,
        description: author.credential,
        url: author.url,
      },
      publisher: {
        '@type': 'Organization',
        name: 'stonemegan.dev',
        logo: { '@type': 'ImageObject', url: new URL('/logo.png', Astro.site).toString() },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': fm.canonical },
      keywords: fm.keywords.join(', '),
    }}
  />

  <Schema
    type="BreadcrumbList"
    data={{
      itemListElement: breadcrumb.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: b.url,
      })),
    }}
  />
</BaseLayout>
